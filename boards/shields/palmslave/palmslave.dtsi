#include <dt-bindings/zmk/matrix_transform.h>
#include "palmslave_layouts.dtsi"

/ {
    chosen {
        zmk,physical-layout = &physical_layout0;
        zmk,battery = &non_lipo_battery; //追記
    };

    kscan0: kscan0 {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        wakeup-source;

        row-gpios
            = <&bmp 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
            <&bmp 19 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
            <&bmp 18 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
            <&bmp 17 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
    };

    default_transform: keymap_transform0 {
        compatible = "zmk,matrix-transform";
        columns = <10>;
        rows = <4>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)     RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4)     RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4)     RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9)
                    RC(3,1) RC(3,2) RC(3,3) RC(3,4)     RC(3,5) RC(3,6) RC(3,7) RC(3,8)
        >;
    };

    physical_layout0: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "LAYOUT";

        kscan = <&kscan0>;
        transform = <&default_transform>;
    };

// 追記
    vbatt: vbatt {
        // Disable default battery monitoring0
        // torabo-tsuki-lp参照
        status = "disabled";
    };

    non_lipo_battery: non_lipo_battery {
        compatible = "zmk,non-lipo-battery";
        io-channels = <&adc 4>;  // 使用するADCチャンネル　A0ピン (P0.28, AIN4)
        // status = "okay"; // ChatGPT助言で追記

        // オプション: 電圧分圧器の電源制御GPIO
        // power-gpios = <&gpio0 3 GPIO_ACTIVE_HIGH>;  // 使用するGPIOに置き換えてください
    };

// 追記ここまで

};

// 以下追記
&adc {
    status = "okay";
};


